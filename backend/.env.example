# ═══════════════════════════════════════════════════
# No Meu Bairro — Variáveis de ambiente
# Copie para .env e preencha os valores
# ═══════════════════════════════════════════════════

# Aplicação
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=altere-para-uma-chave-secreta-forte-e-aleatoria

# PostgreSQL
DATABASE_URL=postgresql://anb_user:sua_senha_aqui@localhost:5432/aqui_no_meu_bairro

# JWT
JWT_SECRET_KEY=altere-para-outra-chave-secreta-jwt
JWT_ACCESS_TOKEN_EXPIRES=3600    # 1 hora em segundos
JWT_REFRESH_TOKEN_EXPIRES=2592000 # 30 dias em segundos

# Argon2 (para hash de senhas)
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=102400
ARGON2_PARALLELISM=8

# Rate Limiting
RATE_LIMIT_DEFAULT=100/hour
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_DENUNCIAS=3/hour

# Upload de imagens
MAX_CONTENT_LENGTH=10485760       # 10MB
UPLOAD_FOLDER=./uploads

# E2EE (denúncias)
E2EE_PRIVATE_KEY_PATH=./keys/private.pem
E2EE_PUBLIC_KEY_PATH=./keys/public.pem
