{
  "id": "/",
  "name": "No Meu Bairro",
  "short_name": "Meu Bairro",
  "description": "Plataforma comunitária de Curitiba para relatos, mapa, dados, empregos e eventos.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f8fafc",
  "theme_color": "#059669",
  "lang": "pt-BR",
  "categories": ["social", "utilities", "local"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Novo relato",
      "short_name": "Relatar",
      "description": "Abra o feed para publicar um relato comunitário.",
      "url": "/#/?acao=novo-relato",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Mapa comunitário",
      "short_name": "Mapa",
      "description": "Veja relatos, eventos e vagas no mapa.",
      "url": "/#/mapa",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
