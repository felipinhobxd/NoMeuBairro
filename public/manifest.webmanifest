{
  "id": "/",
  "name": "No Meu Bairro",
  "short_name": "Meu Bairro",
  "description": "Plataforma comunitária de Curitiba para relatos, mapa, dados, empregos e eventos.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0c1320",
  "theme_color": "#059669",
  "lang": "pt-BR",
  "categories": [
    "social",
    "utilities",
    "local"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/logo.png",
      "sizes": "any",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logo.png",
      "sizes": "any",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Novo relato",
      "short_name": "Relatar",
      "description": "Abra o feed para publicar um relato comunitário.",
      "url": "/#/?acao=novo-relato",
      "icons": [
        {
          "src": "/logo.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Mapa comunitário",
      "short_name": "Mapa",
      "description": "Veja relatos, eventos e vagas no mapa.",
      "url": "/#/mapa",
      "icons": [
        {
          "src": "/logo.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
